<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="match_parent"
 android:orientation="vertical" android:background="#0A0A0A" android:gravity="center">
 <TextView android:text="NANDOMX MEXICO" android:textColor="#00FF88" android:textSize="24sp" android:textStyle="bold"/>
 <FrameLayout android:layout_width="220dp" android:layout_height="220dp" android:layout_marginTop="30dp">
   <ImageView android:id="@+id/ring_anim" android:layout_width="220dp" android:layout_height="220dp" android:src="@mipmap/ic_launcher"/>
   <ImageView android:id="@+id/btn_power" android:layout_width="120dp" android:layout_height="120dp" android:layout_gravity="center" android:src="@mipmap/ic_launcher" android:clickable="true"/>
 </FrameLayout>
 <TextView android:id="@+id/txt_status" android:text="NO CONECTADO" android:textColor="#FF4444" android:layout_marginTop="20dp"/>
 <TextView android:text="Configuracion Activa: Sin importar (ej: oxxocell era ejemplo)" android:textColor="#AAAAAA" android:layout_marginTop="15dp"/>
</LinearLayout>
